<dialog id="confirm-delete" class="confirm-delete" aria-labelledby="confirm-delete-title" aria-describedby="confirm-delete-desc">
  <div class="confirm-delete-sheet">
    <h2 id="confirm-delete-title">Xóa phiếu này?</h2>
    <p id="confirm-delete-desc">
      Phiếu số <strong id="confirm-delete-no"></strong> sẽ bị xóa vĩnh viễn, gồm cả các dòng hàng.
      Không thể hoàn tác.
    </p>
    <div class="confirm-delete-actions">
      <button type="button" class="ghost" data-confirm-cancel>Giữ lại</button>
      <form id="confirm-delete-form" method="post" action="">
        <button type="submit" class="btn danger">Xóa phiếu</button>
      </form>
    </div>
  </div>
</dialog>
